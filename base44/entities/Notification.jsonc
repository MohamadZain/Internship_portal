{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning"
      ],
      "default": "info"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "recipient_role": {
      "type": "string",
      "enum": [
        "student",
        "startup",
        "admin"
      ]
    }
  },
  "required": [
    "title"
  ]
}